{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "successCmd": "echo \"version=${nextRelease.version}\" >> $GITHUB_OUTPUT && echo \"published=true\" >> $GITHUB_OUTPUT"
      }
    ],
    [
      "@semantic-release/github",
      {
        "successComment": false,
        "failComment": false,
        "labels": false,
        "assignees": []
      }
    ]
  ]
}
